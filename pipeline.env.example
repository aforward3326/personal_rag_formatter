# ==========================================
# Global Settings
# ==========================================

# Your email address (used to filter threads with two-way interaction)
MY_EMAIL=your.email@example.com


# ==========================================
# AI Provider & Model Settings
# ==========================================

# Specify the LLM provider to use for metadata tagging and filtering
AI_PROVIDER=openai

# LLM model name
# - OpenAI: gpt-4o-mini, gpt-4-turbo
# - Gemini/Vertex: gemini-1.5-flash-latest, gemini-1.5-pro-latest
# - Anthropic: claude-3-haiku-20240307
# - Local: a-local-model-name
LLM_MODEL_NAME=gpt-4o-mini

# Specify the Embedding provider to use
EMBEDDING_PROVIDER=openai

# Embedding model name
# - OpenAI: text-embedding-3-small, text-embedding-3-large
# - Gemini/Vertex: text-embedding-004
# - BGE (LM Studio): text-embedding-bge-m3-16F
EMBEDDING_MODEL_NAME=text-embedding-3-small

# Embedding dimensions
# - text-embedding-3-small: 1536
# - text-embedding-004: 768
# - text-embedding-bge-m3-16F: 1024
EMBEDDING_DIM=1536


# ==========================================
# API Keys & Endpoints
# ==========================================

# OpenAI API Key (ChatGPT)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini API Key (for use with google-generativeai SDK for both Gemini and Vertex AI)
GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Google Cloud Vertex AI Settings (if using 'vertex' provider) ---
# Your Google Cloud Project ID
VERTEX_PROJECT_ID=personal-rag-formatter
# The location of your Vertex AI resources
VERTEX_LOCATION=us-central1

# Anthropic API Key (Claude)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# LM Studio or other OpenAI-compatible local endpoint URL
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio

# AnythingLLM OpenAI-compatible endpoint URL and API key
ANYTHINGLLM_BASE_URL=http://localhost:3001/api/v1/
ANYTHINGLLM_API_KEY=your-anythingllm-api-key
# AnythingLLM Workspace Slug (unique identifier for the workspace)
ANYTHINGLLM_WORKSPACE_SLUG=my-workspace


# ==========================================
# Batch Processing Settings (Vertex AI)
# ==========================================

# Enable Vertex AI Batch API mode for mass processing
USE_BATCH_API=false

# Google Cloud Storage bucket name for Batch API input/output
GCS_BUCKET_NAME=your-gcs-bucket-name

# Maximum number of lines per shard file for Batch API
BATCH_MAX_LINES=50000


# ==========================================
# Database Connection Settings
# ==========================================

# Vector Database type
VECTOR_DB_TYPE=postgres

# --- Postgres/pgvector Settings ---
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_password
PG_DB_NAME=rag_db

# --- ChromaDB Settings ---
# ChromaDB collection name, equivalent to a database table
COLLECTION_NAME=enterprise_knowledge
# ChromaDB local storage path (if using local persistence mode)
CHROMA_DB_DIR=./chroma_db
# ChromaDB remote server IP (if using Server/Client mode)
CHROMA_DB_HOST=127.0.0.1
# ChromaDB remote server Port
CHROMA_DB_PORT=8000


# ==========================================
# Corpus Builder Pipeline Settings
# ==========================================
CORPUS_INPUT_DIR=./data/input/org_data/word_data
CORPUS_OUTPUT_FILE=personal_corpus_rag_ready.json


# ==========================================
# Gmail Pipeline Settings
# ==========================================
MBOX_DIR_PATH=./data/input/org_data/mail_data
OUTPUT_DIR=./data/output/output_clean_data
OUTPUT_FILE=gmail_corpus_rag_ready.json


# ==========================================
# Meta Pipeline Settings
# ==========================================
META_ORG_DATA_DIR=./data/input/org_data
META_OUTPUT_FILE=meta_rag_ready_data.json


# ==========================================
# Chat HTML Pipeline Settings
# ==========================================
CHAT_HTML_DIR=./data/input/org_data/chat_data
CHAT_HTML_OUTPUT=chat_messages_rag_ready.json


# ==========================================
# Anonymization Pipeline Settings
# ==========================================
ANONYMIZE_INPUT_DIR=./data/output/output_clean_data
ANONYMIZE_OUTPUT_DIR=./data/output/output_mask_data
# Phase 2: Final clean data ready to be imported into the vector database after LLM processing
LLM_CLEANED_DIR=./data/output/llm_cleaned_data

# System cache and log directories (state machine cache, error logs, system logs)
CACHE_DIR=./data/cache
PROC_DIR=./data/processing
ERROR_DIR=./data/error
LOG_DIR=./data/log

# Test mode setting (true/false) - If enabled, only local token estimation will be performed, and no AI requests or storage will occur.
RAG_TEST_MODE=false
RAG_TEST_HIDE_CONTENT=false

# ==========================================
# Anonymization Settings
# ==========================================
MY_IDENTITIES_MATRIX={"Your Name": "[AUTHOR_ME]", "Your Nickname": "[AUTHOR_ME]", "your.email@example.com": "[AUTHOR_ME]"}
SENSITIVE_WORDS_MAP={"某某科技股份有限公司": "[REDACTED_COMPANY]", "內部機密專案X": "[REDACTED_PROJECT]", "台北市信義區市府路1號": "[REDACTED_ADDRESS]"}