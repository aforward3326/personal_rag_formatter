# ==========================================
# Global Settings (全域設定)
# ==========================================

# 您的信箱 (用於過濾確認有本人參與回覆的雙向互動郵件)
# Your email address (used to filter threads with two-way interaction)
MY_EMAIL=your.email@example.com


# ==========================================
# AI Provider & Model Settings (大語言模型與 API 服務選擇)
# ==========================================

# 指定要使用的 LLM 提供者 (支援選項: openai, gemini, anthropic, lm_studio, azure)
# Specify the LLM provider to use for metadata tagging and filtering
AI_PROVIDER=openai

# LLM 模型名稱 (如: gpt-4o-mini, gemini-1.5-flash, claude-3-haiku-20240307, local-model-name)
# LLM Model Name
LLM_MODEL_NAME=gpt-4o-mini

# 指定要使用的 Embedding 提供者 (支援選項: openai, gemini, lm_studio)
# Specify the Embedding provider to use for ChromaDB
EMBEDDING_PROVIDER=openai

# Embedding 模型名稱 (如: text-embedding-3-small, models/embedding-001, nomic-embed-text)
# Embedding Model Name
EMBEDDING_MODEL_NAME=text-embedding-3-small


# ==========================================
# API Keys & Endpoints (各家 API 金鑰與伺服器路徑)
# ==========================================

# OpenAI API Key (ChatGPT)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini API Key
GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API Key (Claude)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# LM Studio 或其他兼容 OpenAI 格式的本地端 URL (Local endpoint)
# 預設為 LM Studio 啟動的 Local Server
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# LM Studio API Key (此金鑰為本地伺服器佔位符，可為任意字串)
# LM Studio API Key (this is a placeholder for the local server and can be any string)
LM_STUDIO_API_KEY=sk-lm-xxxxxxxxxxxxxxxxxxxxxxxx

# Azure OpenAI 設定 (如果使用的是微軟企業版 Azure Copilot/OpenAI)
# Azure OpenAI configurations
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-01


# ==========================================
# Database Connection Settings (資料庫連線設定)
# ==========================================

# 向量資料庫類型 (預設: chromadb, 支援: chromadb, pinecone, milvus, qdrant)
# Vector Database type
VECTOR_DB_TYPE=chromadb

# ChromaDB 集合(Collection)名稱，相當於資料表
# ChromaDB collection name
COLLECTION_NAME=enterprise_knowledge

# ChromaDB 向量資料庫本地端儲存路徑 (若使用本地持久化模式)
# ChromaDB Vector Database local storage path (for local persistent mode)
CHROMA_DB_DIR=./chroma_db

# ChromaDB 遠端伺服器 IP (如果使用 Server/Client 模式)
# ChromaDB remote server host IP
CHROMA_DB_HOST=127.0.0.1

# ChromaDB 遠端伺服器 Port
# ChromaDB remote server port
CHROMA_DB_PORT=8000

# Pinecone API 金鑰與環境 (若使用 Pinecone)
# Pinecone API Key and Environment
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1-aws

# Milvus/Zilliz 伺服器 URI 與 Token (若使用 Milvus)
# Milvus / Zilliz URI and Token
MILVUS_URI=https://in03-xxxxxxxxxxxx.api.gcp-us-west1.zillizcloud.com
MILVUS_TOKEN=your-milvus-token


# ==========================================
# Corpus Builder Pipeline (Word/PDF 基礎語料庫解析設定)
# ==========================================
CORPUS_INPUT_DIR=./org_data/word_data
CORPUS_OUTPUT_FILE=output_clean_data/personal_corpus_rag_ready.json


# ==========================================
# Gmail Pipeline (Gmail 郵件資料解析設定)
# ==========================================
MBOX_DIR_PATH=./org_data/mail_data
OUTPUT_DIR=./output_clean_data
OUTPUT_FILE=gmail_corpus_rag_ready.json


# ==========================================
# Meta Pipeline (Facebook/Instagram/Threads 資料解析設定)
# ==========================================
META_ORG_DATA_DIR=./org_data
META_OUTPUT_FILE=output_clean_data/meta_rag_ready_data.json


# ==========================================
# Chat HTML Pipeline (LINE/WhatsApp 通訊軟體對話解析設定)
# ==========================================
CHAT_HTML_DIR=./org_data/chat_data
CHAT_HTML_OUTPUT=output_clean_data/chat_messages_rag_ready.json


# ==========================================
# Anonymization Pipeline (資料去識別化/去敏設定)
# ==========================================
ANONYMIZE_INPUT_DIR=./output_clean_data
ANONYMIZE_OUTPUT_DIR=./output_mask_data

# 本人識別名稱矩陣，用於去識別化時轉換為 [AUTHOR_ME]，格式為 JSON 字串
# Identity Matrix for the author to be masked as [AUTHOR_ME], in JSON string format
# e.g., {"John": "[AUTHOR_ME]", "john@email.com": "[AUTHOR_ME]"}
MY_IDENTITIES_MATRIX={"Your Name": "[AUTHOR_ME]", "Your Nickname": "[AUTHOR_ME]", "your.email@example.com": "[AUTHOR_ME]"}

# 自訂敏感詞與對應的替換標籤，格式為 JSON 字串
# Custom Sensitive Words Map and their replacement tags, in JSON string format
# e.g., {"SecretProjectX": "[REDACTED_PROJECT]"}
SENSITIVE_WORDS_MAP={"某某科技股份有限公司": "[REDACTED_COMPANY]", "內部機密專案X": "[REDACTED_PROJECT]", "台北市信義區市府路1號": "[REDACTED_ADDRESS]"}

# ==========================================
# RAG Ingestion Pipeline (向量資料庫寫入與最終審查設定)
# ==========================================
DATA_DIR=./output_final_rag_data